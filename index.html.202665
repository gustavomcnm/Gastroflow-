<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0,viewport-fit=cover">
<meta name="theme-color" content="#0f172a">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="GastroFlow">
<meta name="description" content="GastroFlow - Gestão completa para bar, restaurante, mesas, pedidos, estoque, caixa e delivery">
<title>GastroFlow - Gestão Completa</title>

<style>
*{box-sizing:border-box}
html{scroll-behavior:smooth}

body{
margin:0;
font-family:Inter,Arial,Helvetica,sans-serif;
background:#f5f7fb;
color:#172033;
font-size:17px;
line-height:1.5;
-webkit-tap-highlight-color:transparent
}

header{
background:linear-gradient(135deg,#0f172a,#1e3a8a);
color:#fff;
padding:30px 18px 28px;
text-align:center;
box-shadow:0 5px 20px rgba(15,23,42,.18)
}

header h1{margin:0;font-size:34px;font-weight:800}
header p{margin:8px 0 0;color:#dbeafe}

.menu{
display:flex;
flex-wrap:wrap;
gap:10px;
padding:16px;
background:#fff;
border-bottom:1px solid #e2e8f0;
justify-content:center;
box-shadow:0 3px 12px rgba(15,23,42,.06)
}

.menu-btn{
border:1px solid #e2e8f0;
background:#f8fafc;
color:#334155;
padding:13px 18px;
border-radius:12px;
font-size:16px;
font-weight:700;
cursor:pointer;
transition:.2s
}

.menu-btn:hover{
background:#eff6ff;
color:#1d4ed8;
transform:translateY(-2px)
}

main{
max-width:1280px;
margin:auto;
padding:28px 20px 50px
}

.modulo{display:none}
.modulo.ativo{
display:block;
animation:entrada .2s ease
}

@keyframes entrada{
from{opacity:0;transform:translateY(5px)}
to{opacity:1;transform:translateY(0)}
}

.titulo-modulo{
position:relative;
margin:0 0 24px;
padding-bottom:12px;
font-size:30px;
font-weight:800;
color:#0f172a
}

.titulo-modulo:after{
content:"";
position:absolute;
left:0;
bottom:0;
width:55px;
height:4px;
border-radius:10px;
background:linear-gradient(90deg,#2563eb,#60a5fa)
}

.card,.item-card,.mesa-card{
background:#fff;
border:1px solid #e4e9f1;
border-radius:18px;
padding:21px;
margin-bottom:20px;
box-shadow:0 5px 18px rgba(15,23,42,.06)
}

.item-card:hover,.mesa-card:hover{
transform:translateY(-2px);
box-shadow:0 9px 22px rgba(15,23,42,.09)
}

.form-grid{
display:grid;
grid-template-columns:repeat(auto-fit,minmax(220px,1fr));
gap:17px
}

label{
display:block;
font-weight:700;
margin-bottom:7px;
color:#334155
}

input,select,textarea{
width:100%;
padding:14px 15px;
border:1px solid #cbd5e1;
border-radius:11px;
font-size:17px;
background:#fff;
color:#172033;
outline:none;
font-family:inherit
}

textarea{
min-height:100px;
resize:vertical
}

input:focus,select:focus,textarea:focus{
border-color:#2563eb;
box-shadow:0 0 0 4px rgba(37,99,235,.11)
}

button{font-family:inherit}

.btn{
border:0;
border-radius:11px;
padding:13px 18px;
font-size:16px;
font-weight:700;
cursor:pointer;
transition:.18s;
box-shadow:0 3px 8px rgba(15,23,42,.08)
}

.btn:hover{transform:translateY(-2px)}
.btn-primary{background:linear-gradient(135deg,#2563eb,#1d4ed8);color:#fff}
.btn-success{background:linear-gradient(135deg,#16a34a,#15803d);color:#fff}
.btn-danger{background:linear-gradient(135deg,#ef4444,#dc2626);color:#fff}
.btn-warning{background:linear-gradient(135deg,#f59e0b,#d97706);color:#fff}
.btn-secondary{background:linear-gradient(135deg,#64748b,#475569);color:#fff}
.btn-relatorio{background:linear-gradient(135deg,#0f766e,#0d9488);color:#fff}
.btn-imprimir{background:#111827;color:#fff}

.acoes{
display:flex;
flex-wrap:wrap;
gap:10px;
margin-top:17px
}

.resumo{
display:grid;
grid-template-columns:repeat(auto-fit,minmax(190px,1fr));
gap:16px;
margin-bottom:22px
}

.resumo-card{
position:relative;
overflow:hidden;
background:#fff;
border:1px solid #e5eaf1;
padding:21px;
border-radius:17px;
box-shadow:0 5px 16px rgba(15,23,42,.055);
color:#64748b;
font-weight:700
}

.resumo-card:before{
content:"";
position:absolute;
top:0;
left:0;
right:0;
height:4px;
background:#2563eb
}

.resumo-card strong{
display:block;
font-size:30px;
margin-top:8px;
color:#0f172a
}

.lista{
display:grid;
gap:16px
}

.badge{
display:inline-block;
padding:6px 11px;
border-radius:999px;
font-size:13px;
font-weight:800
}

.badge-aberta{background:#dcfce7;color:#166534}
.badge-livre{background:#f1f5f9;color:#475569}
.badge-pendente{background:#fef3c7;color:#92400e}
.badge-preparo{background:#dbeafe;color:#1e40af}
.badge-pronto{background:#fce7f3;color:#9d174d}
.badge-entregue{background:#dcfce7;color:#166534}
.badge-novo{background:#ede9fe;color:#6d28d9}
.badge-saiu{background:#ffedd5;color:#c2410c}
.badge-delivery{background:#e0f2fe;color:#0369a1}

.mesas-grid{
display:grid;
grid-template-columns:repeat(auto-fill,minmax(270px,1fr));
gap:17px
}

.mesa-card{position:relative}
.mesa-card.aberta{border:2px solid #86efac}

.item-linha{
padding:13px 0;
border-bottom:1px solid #edf1f5
}

.item-linha-top{
display:flex;
justify-content:space-between;
gap:10px
}

.caixa-card{border:2px solid #93c5fd}
.delivery-card{border:2px solid #bfdbfe}
.delivery-card.novo{border-color:#c4b5fd}
.delivery-card.preparo{border-color:#93c5fd}
.delivery-card.pronto{border-color:#86efac}
.delivery-card.saiu{border-color:#fdba74}

.btn-receber,
.btn-enviar-preparo,
.btn-marcar-pronto,
.btn-marcar-entregue{
width:100%;
border:0;
border-radius:11px;
padding:15px;
color:#fff;
font-weight:800;
cursor:pointer;
margin-top:11px
}

.btn-receber{
background:linear-gradient(135deg,#16a34a,#15803d);
font-size:18px
}

.btn-enviar-preparo{
background:linear-gradient(135deg,#f97316,#ea580c)
}

.btn-marcar-pronto{
background:linear-gradient(135deg,#3b82f6,#2563eb)
}

.btn-marcar-entregue{
background:linear-gradient(135deg,#22c55e,#16a34a)
}

.tabela-container{overflow-x:auto}

.tabela{
width:100%;
border-collapse:collapse
}

.tabela th,.tabela td{
padding:14px;
border-bottom:1px solid #e8edf3;
text-align:left
}

.tabela th{background:#f8fafc}
.tabela tbody tr:nth-child(even){background:#fafbfc}

.alerta{
padding:14px 16px;
border-radius:11px;
margin-top:11px;
font-weight:600
}

.alerta-baixo{
background:#fef2f2;
color:#991b1b;
border:1px solid #fecaca
}

.alerta-ok{
background:#f0fdf4;
color:#166534;
border:1px solid #bbf7d0
}

.mensagem{
position:fixed;
right:20px;
bottom:20px;
max-width:380px;
padding:17px 20px;
border-radius:14px;
color:#fff;
font-weight:700;
display:none;
z-index:9999;
box-shadow:0 10px 30px rgba(0,0,0,.22)
}

.mensagem.sucesso{
background:linear-gradient(135deg,#16a34a,#15803d)
}

.mensagem.erro{
background:linear-gradient(135deg,#dc2626,#b91c1c)
}

.modal{
display:none;
position:fixed;
inset:0;
background:rgba(15,23,42,.68);
backdrop-filter:blur(4px);
z-index:5000;
align-items:center;
justify-content:center;
padding:20px
}

.modal.ativo{display:flex}

.modal-conteudo{
background:#fff;
width:100%;
max-width:700px;
max-height:90vh;
overflow:auto;
border-radius:20px;
padding:25px;
box-shadow:0 25px 70px rgba(0,0,0,.28)
}

.confirmacao-pagamento{
border:2px solid #22c55e;
background:#f0fdf4;
border-radius:16px;
padding:19px;
margin-top:15px
}

.confirmacao-pagamento .valor{
font-size:34px;
font-weight:900;
color:#2563eb;
margin:12px 0
}

.btn-confirmar-pagamento,
.btn-cancelar-pagamento{
width:100%;
border:0;
border-radius:11px;
padding:17px;
color:#fff;
font-size:18px;
font-weight:800;
cursor:pointer
}

.btn-confirmar-pagamento{
background:linear-gradient(135deg,#16a34a,#15803d)
}

.btn-cancelar-pagamento{
background:#64748b;
margin-top:10px
}

.relatorio-destaque{border:2px solid #60a5fa}
.relatorio-lucro{border:2px solid #4ade80}
.relatorio-alerta{border:2px solid #fca5a5}

.periodo-rapido{
display:flex;
flex-wrap:wrap;
gap:10px;
margin-top:16px
}

.periodo-rapido .btn{
flex:1;
min-width:140px
}

.sem-dados{
padding:24px;
text-align:center;
color:#64748b;
background:#f8fafc;
border-radius:12px
}

.foto-produto-area{
grid-column:1/-1;
display:flex;
align-items:center;
gap:20px;
flex-wrap:wrap;
padding:18px;
background:#f8fafc;
border:1px dashed #bfdbfe;
border-radius:16px
}

.preview-foto{
width:130px;
height:130px;
border-radius:18px;
overflow:hidden;
background:#e2e8f0;
display:flex;
align-items:center;
justify-content:center;
border:2px solid #dbeafe;
flex-shrink:0
}

.preview-foto img{
width:100%;
height:100%;
object-fit:cover
}

.preview-foto-vazia{
text-align:center;
color:#64748b;
font-size:14px;
padding:10px
}

.foto-produto-acoes{
flex:1;
min-width:220px
}

.foto-produto-acoes input[type=file]{
padding:10px;
background:#fff
}

.produto-card-com-foto{
display:grid;
grid-template-columns:150px 1fr;
gap:20px;
align-items:start
}

.produto-foto-card{
width:150px;
height:150px;
border-radius:18px;
overflow:hidden;
background:#eef2f7;
border:1px solid #e2e8f0;
display:flex;
align-items:center;
justify-content:center;
font-size:48px
}

.produto-foto-card img{
width:100%;
height:100%;
object-fit:cover
}

.produto-foto-vazia{font-size:48px}

.delivery-produto{
display:grid;
grid-template-columns:70px 1fr 100px;
gap:14px;
align-items:center;
padding:12px;
border:1px solid #e2e8f0;
border-radius:14px;
margin-bottom:10px;
background:#fff
}

.delivery-produto img,
.delivery-produto-sem-foto{
width:70px;
height:70px;
border-radius:12px;
object-fit:cover;
background:#eef2f7;
display:flex;
align-items:center;
justify-content:center;
font-size:30px
}

.delivery-produto-info strong{
display:block;
font-size:17px
}

.delivery-produto-info small{color:#64748b}

.delivery-quantidade{
display:flex;
align-items:center;
justify-content:flex-end;
gap:5px
}

.delivery-quantidade button{
width:32px;
height:32px;
border:0;
border-radius:8px;
background:#e0e7ff;
color:#1d4ed8;
font-weight:900;
cursor:pointer
}

.delivery-quantidade span{
min-width:28px;
text-align:center;
font-weight:800
}

.delivery-total{
padding:18px;
border-radius:15px;
background:#eff6ff;
border:2px solid #bfdbfe;
text-align:right;
margin-top:15px
}

.delivery-total strong{
display:block;
font-size:30px;
color:#1d4ed8
}

.delivery-resumo{
display:grid;
grid-template-columns:repeat(auto-fit,minmax(170px,1fr));
gap:12px
}

.delivery-resumo-item{
background:#f8fafc;
border-radius:12px;
padding:12px
}

.delivery-resumo-item strong{
display:block;
margin-top:4px
}

/* PAINEL */

.painel-boas-vindas{
background:linear-gradient(135deg,#eff6ff,#dbeafe);
border:1px solid #bfdbfe;
border-radius:18px;
padding:24px;
margin-bottom:22px
}

.painel-boas-vindas h3{
margin:0 0 5px;
color:#1e3a8a
}

.painel-boas-vindas p{
margin:0;
color:#475569
}

.painel-grid{
display:grid;
grid-template-columns:repeat(auto-fit,minmax(220px,1fr));
gap:18px;
margin-bottom:24px
}

.painel-card{
position:relative;
overflow:hidden;
background:#fff;
border:1px solid #e4e9f1;
border-radius:18px;
padding:22px;
box-shadow:0 6px 20px rgba(15,23,42,.07);
color:#475569;
font-weight:700
}

.painel-card:before{
content:"";
position:absolute;
left:0;
top:0;
bottom:0;
width:5px;
background:#2563eb
}

.painel-card strong{
display:block;
margin-top:8px;
font-size:30px;
color:#0f172a
}

.painel-card small{
color:#64748b;
font-weight:600
}

.painel-card.verde:before{background:#16a34a}
.painel-card.laranja:before{background:#f97316}
.painel-card.roxo:before{background:#7c3aed}
.painel-card.vermelho:before{background:#dc2626}
.painel-card.azul:before{background:#2563eb}
.painel-card.teal:before{background:#0d9488}

.painel-acoes{
display:grid;
grid-template-columns:repeat(auto-fit,minmax(180px,1fr));
gap:12px
}

.painel-acoes .btn{width:100%}

/* FLUXO DOS PEDIDOS */

.pedidos-fluxo{
display:grid;
grid-template-columns:repeat(4,1fr);
gap:12px;
margin-bottom:24px
}

.pedido-etapa{
background:#fff;
border:1px solid #e2e8f0;
border-radius:15px;
padding:15px;
text-align:center;
box-shadow:0 4px 12px rgba(15,23,42,.05)
}

.pedido-etapa span{
display:block;
font-size:28px;
margin-bottom:3px
}

.pedido-etapa strong{
display:block;
font-size:24px;
color:#0f172a
}

.pedido-etapa small{color:#64748b}

.pedidos-colunas{
display:grid;
grid-template-columns:repeat(3,1fr);
gap:18px;
align-items:start
}

.pedidos-coluna{
background:#eef2f7;
border-radius:18px;
padding:15px;
min-height:120px
}

.pedidos-coluna h3{
margin:0 0 14px;
font-size:18px
}

.pedidos-coluna.pendente{
border-top:5px solid #f59e0b
}

.pedidos-coluna.preparo{
border-top:5px solid #3b82f6
}

.pedidos-coluna.pronto{
border-top:5px solid #16a34a
}

.pedido-card{
background:#fff;
border:1px solid #e2e8f0;
border-radius:16px;
padding:16px;
margin-bottom:13px;
box-shadow:0 4px 12px rgba(15,23,42,.06)
}

.pedido-card:last-child{margin-bottom:0}

.pedido-cabecalho{
display:flex;
justify-content:space-between;
align-items:flex-start;
gap:10px;
margin-bottom:10px
}

.pedido-cabecalho h4{
margin:0;
font-size:19px;
color:#0f172a
}

.pedido-cliente{
font-size:14px;
color:#64748b;
margin:2px 0 10px
}

.pedido-item{
display:flex;
justify-content:space-between;
gap:8px;
padding:9px 0;
border-bottom:1px solid #edf1f5;
font-size:15px;
flex-wrap:wrap
}

.pedido-item:last-of-type{border-bottom:0}

.pedido-item-info{
flex:1;
min-width:150px
}

.pedido-item-acao{
width:100%;
display:flex;
gap:7px;
margin-top:4px
}

.btn-item-preparo{
width:100%;
border:0;
border-radius:9px;
padding:9px 12px;
background:#fff7ed;
border:1px solid #fdba74;
color:#c2410c;
font-size:14px;
font-weight:800;
cursor:pointer
}

.btn-item-preparo:hover{
background:#ffedd5
}

.pedido-total{
display:flex;
justify-content:space-between;
margin-top:10px;
padding-top:10px;
border-top:2px solid #f1f5f9;
font-weight:800
}

.pedido-botao{
width:100%;
border:0;
border-radius:10px;
padding:12px;
color:#fff;
font-weight:800;
cursor:pointer;
margin-top:12px
}

.pedido-botao.preparo{
background:linear-gradient(135deg,#f97316,#ea580c)
}

.pedido-botao.pronto{
background:linear-gradient(135deg,#2563eb,#1d4ed8)
}

.pedido-botao.entregue{
background:linear-gradient(135deg,#16a34a,#15803d)
}

.pedido-vazio{
background:#fff;
border:1px dashed #cbd5e1;
border-radius:12px;
padding:20px;
text-align:center;
color:#64748b;
font-size:14px
}

.pedido-ajuda{
background:#eff6ff;
border:1px solid #bfdbfe;
border-radius:12px;
padding:12px 14px;
color:#1e40af;
font-size:14px;
margin-bottom:14px
}

/* BACKUP */

.backup-destaque{
border:2px solid #60a5fa;
background:linear-gradient(135deg,#eff6ff,#ffffff)
}

.backup-icone{
font-size:48px;
margin-bottom:8px
}

.backup-aviso{
border:2px solid #fbbf24;
background:#fffbeb;
color:#92400e;
border-radius:16px;
padding:18px;
margin-top:20px
}

.backup-arquivo{
border:1px dashed #93c5fd;
background:#f8fafc;
border-radius:15px;
padding:16px;
margin-top:16px
}



/* RECURSOS COMERCIAIS */

.recursos-comerciais{
margin-top:20px;
border:1px solid #bfdbfe;
background:linear-gradient(135deg,#ffffff,#eff6ff)
}

.recursos-comerciais h3{
margin:0 0 5px;
font-size:22px;
color:#0f172a
}

.recursos-intro{
margin:0 0 18px;
color:#64748b
}

.recursos-grid{
display:grid;
grid-template-columns:repeat(auto-fit,minmax(250px,1fr));
gap:14px
}

.recurso-comercial{
display:flex;
align-items:flex-start;
gap:13px;
padding:17px;
background:#fff;
border:1px solid #e2e8f0;
border-radius:15px;
box-shadow:0 4px 12px rgba(15,23,42,.04)
}

.recurso-icone{
width:46px;
height:46px;
border-radius:13px;
background:#eff6ff;
display:flex;
align-items:center;
justify-content:center;
font-size:25px;
flex-shrink:0
}

.recurso-categoria{
display:block;
font-size:11px;
font-weight:900;
letter-spacing:.08em;
color:#2563eb;
margin-bottom:4px
}

.recurso-comercial strong{
display:block;
font-size:17px;
color:#0f172a
}

.recurso-comercial p{
margin:3px 0 0;
color:#64748b;
font-size:14px
}

/* CONTATO E SUPORTE */

a.btn{
text-decoration:none;
display:inline-flex;
align-items:center;
justify-content:center
}

.suporte-destaque{
border:2px solid #60a5fa;
background:linear-gradient(135deg,#eff6ff,#ffffff)
}

.suporte-icone{
font-size:52px;
margin-bottom:8px
}

.suporte-grid{
display:grid;
grid-template-columns:repeat(auto-fit,minmax(220px,1fr));
gap:16px;
margin-top:18px
}

.suporte-item{
background:#f8fafc;
border:1px solid #e2e8f0;
border-radius:16px;
padding:20px;
box-shadow:0 4px 12px rgba(15,23,42,.04)
}

.suporte-item strong{
display:block;
margin-top:6px;
font-size:18px;
color:#0f172a;
word-break:break-word
}

.suporte-item p{
color:#64748b
}

.suporte-badge{
display:inline-block;
margin-top:8px;
padding:7px 12px;
border-radius:999px;
background:#dbeafe;
color:#1d4ed8;
font-weight:800
}

/* INSTALAÇÃO */

.instalar-app{
display:none;
position:fixed;
left:14px;
right:14px;
bottom:14px;
z-index:10000;
background:#0f172a;
color:#fff;
border:1px solid #334155;
border-radius:18px;
padding:14px;
box-shadow:0 15px 40px rgba(0,0,0,.28);
align-items:center;
gap:12px
}

.instalar-app.ativo{
display:flex
}

.instalar-app-info{
flex:1;
min-width:0
}

.instalar-app-info strong{
display:block;
font-size:15px
}

.instalar-app-info small{
display:block;
color:#cbd5e1;
margin-top:2px
}

.instalar-app .btn{
padding:10px 14px;
white-space:nowrap
}

.btn-fechar-instalar{
background:#334155;
color:#fff;
border:0;
border-radius:9px;
width:36px;
height:36px;
font-size:18px;
cursor:pointer
}

@media(max-width:850px){
.pedidos-colunas{grid-template-columns:1fr}
.pedidos-fluxo{grid-template-columns:repeat(2,1fr)}
}

@media(max-width:600px){
body{font-size:16px}
header h1{font-size:26px}
main{padding:16px 12px 35px}
.titulo-modulo{font-size:26px}
.menu{
justify-content:flex-start;
overflow-x:auto;
flex-wrap:nowrap;
padding:12px
}
.menu-btn{white-space:nowrap}

.resumo{
grid-template-columns:repeat(2,minmax(0,1fr));
gap:11px
}

.resumo-card{padding:16px}
.resumo-card strong{font-size:25px}
.mesas-grid{grid-template-columns:1fr}
.modal{padding:12px}
.modal-conteudo{padding:19px}
.mensagem{
left:12px;
right:12px;
bottom:12px;
max-width:none
}

.produto-card-com-foto{grid-template-columns:1fr}
.produto-foto-card{
width:100%;
height:210px
}

.preview-foto{
width:110px;
height:110px
}

.delivery-produto{
grid-template-columns:60px 1fr
}

.delivery-quantidade{
grid-column:1/-1;
justify-content:flex-start
}

.painel-grid{
grid-template-columns:repeat(2,minmax(0,1fr));
gap:11px
}

.painel-card{padding:16px}
.painel-card strong{font-size:24px}

.pedidos-fluxo{
grid-template-columns:repeat(2,1fr);
gap:9px
}

.pedido-etapa{padding:12px}
.pedido-etapa strong{font-size:21px}

.pedido-cabecalho{
flex-direction:column
}
}

@media(max-width:380px){
.resumo{grid-template-columns:1fr}
.painel-grid{grid-template-columns:1fr}
.pedidos-fluxo{grid-template-columns:1fr}
}

@media print{
.menu,.btn,.acoes,.relatorio-filtros,.instalar-app{display:none!important}
.modulo{display:none!important}
#modulo-relatorios{display:block!important}
}

.recurso-clicavel{
width:100%;
text-align:left;
font:inherit;
color:inherit;
cursor:pointer;
appearance:none;
-webkit-appearance:none;
transition:.2s;
}
.recurso-clicavel:hover{
transform:translateY(-3px);
box-shadow:0 10px 24px rgba(15,23,42,.10);
border-color:#93c5fd;
}
.recurso-clicavel:active{transform:translateY(-1px);}
.recurso-clicavel:focus-visible{
outline:3px solid rgba(37,99,235,.25);
outline-offset:2px;
}

/* =========================
   NOVOS RECURSOS OPERACIONAIS
========================= */
.recurso-comercial.recurso-clicavel{border:1px solid #e2e8f0;background:#fff}
.recurso-comercial.recurso-clicavel[data-recurso-modulo]{cursor:pointer}
.recurso-comercial.recurso-clicavel[data-recurso-modulo]:hover{transform:translateY(-3px);box-shadow:0 10px 24px rgba(15,23,42,.10);border-color:#93c5fd}
.recurso-comercial.recurso-clicavel[data-recurso-modulo]:focus-visible{outline:3px solid rgba(37,99,235,.25);outline-offset:2px}
.recurso-status{display:inline-block;margin-top:9px;padding:5px 9px;border-radius:999px;background:#dcfce7;color:#166534;font-size:12px;font-weight:800}
.recurso-status.amarelo{background:#fef3c7;color:#92400e}
.recurso-status.azul{background:#dbeafe;color:#1e40af}
.recurso-status.roxo{background:#ede9fe;color:#6d28d9}
.recurso-painel{display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));gap:14px;margin-bottom:20px}
.recurso-kpi{background:#fff;border:1px solid #e2e8f0;border-radius:16px;padding:18px;box-shadow:0 4px 12px rgba(15,23,42,.05)}
.recurso-kpi strong{display:block;font-size:27px;color:#0f172a;margin-top:5px}
.qr-area{display:grid;grid-template-columns:260px 1fr;gap:22px;align-items:center}
.qr-box{min-height:260px;border:2px dashed #bfdbfe;border-radius:18px;background:#f8fafc;display:flex;align-items:center;justify-content:center;padding:15px;text-align:center}
.qr-box img{max-width:230px;width:100%;border-radius:10px;background:#fff}
.menu-digital-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(230px,1fr));gap:15px}
.menu-digital-card{background:#fff;border:1px solid #e2e8f0;border-radius:17px;overflow:hidden;box-shadow:0 4px 13px rgba(15,23,42,.05)}
.menu-digital-card img,.menu-digital-foto{width:100%;height:155px;object-fit:cover;background:#eef2f7;display:flex;align-items:center;justify-content:center;font-size:50px}
.menu-digital-info{padding:15px}.menu-digital-info h3{margin:0 0 5px}.menu-digital-info p{color:#64748b;font-size:14px;margin:4px 0 10px}.menu-digital-preco{font-size:21px;font-weight:900;color:#1d4ed8}
.dre-grid{display:grid;grid-template-columns:1fr 1fr;gap:18px}.dre-linha{display:flex;justify-content:space-between;padding:11px 0;border-bottom:1px solid #e8edf3}.dre-total{font-size:22px;font-weight:900;padding-top:14px}.positivo{color:#15803d}.negativo{color:#b91c1c}
.fiscal-status{padding:15px;border-radius:14px;border:1px solid #bfdbfe;background:#eff6ff;color:#1e40af;margin-bottom:16px}.fiscal-status.ok{border-color:#bbf7d0;background:#f0fdf4;color:#166534}
.qr-client-link{word-break:break-all;background:#f8fafc;border:1px solid #e2e8f0;padding:12px;border-radius:10px;font-size:13px}
@media(max-width:700px){.qr-area,.dre-grid{grid-template-columns:1fr}.qr-box{min-height:230px}}


/* =========================
   LOGIN / CONTAS GASTROFLOW
========================= */
#telaLogin{position:fixed;inset:0;z-index:20000;background:linear-gradient(135deg,#0f172a,#1e3a8a);display:flex;align-items:center;justify-content:center;padding:20px;overflow:auto}
.login-card{width:100%;max-width:430px;background:#fff;border-radius:24px;padding:30px;box-shadow:0 25px 80px rgba(0,0,0,.35)}
.login-logo{text-align:center;font-size:54px;margin-bottom:5px}.login-card h2{text-align:center;margin:0;color:#0f172a;font-size:28px}.login-card .login-sub{text-align:center;color:#64748b;margin:7px 0 22px}
.login-card .login-field{margin-bottom:14px}.login-card .login-field label{margin-bottom:6px}.login-card .btn{width:100%;margin-top:8px}
.login-secundario{width:100%;border:0;background:transparent;color:#2563eb;font-weight:800;padding:12px;cursor:pointer;margin-top:7px}
.login-erro{display:none;background:#fef2f2;color:#991b1b;border:1px solid #fecaca;border-radius:11px;padding:12px;margin-bottom:14px;font-weight:700}.login-info{font-size:12px;color:#64748b;text-align:center;margin-top:15px;line-height:1.45}
#barraUsuario{display:none;position:fixed;right:14px;top:14px;z-index:10001;background:#fff;border:1px solid #dbeafe;border-radius:12px;padding:8px 10px;box-shadow:0 5px 18px rgba(15,23,42,.15);align-items:center;gap:8px;max-width:calc(100vw - 28px)}
#barraUsuario small{color:#475569;max-width:220px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.perfil-badge{display:inline-flex;align-items:center;padding:4px 7px;border-radius:999px;background:#fef3c7;color:#92400e;font-size:12px;font-weight:900}.perfil-badge.usuario{background:#e2e8f0;color:#475569}
.admin-only{display:none!important}.admin-only.admin-visivel{display:flex!important}.modulo.admin-only.admin-visivel{display:block!important}.btn-logout{border:0;border-radius:8px;padding:7px 10px;background:#ef4444;color:#fff;font-weight:800;cursor:pointer}
body.gastro-bloqueado>header,body.gastro-bloqueado>nav,body.gastro-bloqueado>main,body.gastro-bloqueado>.mensagem,body.gastro-bloqueado>.instalar-app,body.gastro-bloqueado>#barraUsuario{visibility:hidden}
@media(max-width:600px){.login-card{padding:23px;border-radius:20px}#barraUsuario{left:12px;right:12px;justify-content:space-between}.login-card h2{font-size:24px}}

</style>

<script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-app-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-auth-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-database-compat.js"></script>
</head>

<body class="gastro-bloqueado">
<div id="telaLogin" aria-label="Acesso ao GastroFlow">
  <div class="login-card">
    <div class="login-logo">🍽️</div>
    <h2>GastroFlow</h2>
    <p class="login-sub" id="loginTitulo">Entre para acessar seu estabelecimento</p>
    <div id="loginErro" class="login-erro"></div>
    <form id="formLogin">
      <div class="login-field">
        <label for="loginEmail">E-mail</label>
        <input id="loginEmail" type="email" autocomplete="email" placeholder="seu@email.com" required>
      </div>
      <div class="login-field">
        <label for="loginSenha">Senha</label>
        <input id="loginSenha" type="password" autocomplete="current-password" placeholder="Mínimo de 6 caracteres" minlength="6" required>
      </div>
      <button class="btn btn-primary" id="btnEntrar" type="submit">🔐 Entrar</button>
    </form>
    <button type="button" class="login-secundario" id="btnCriarConta">➕ Criar minha conta</button>
    <button type="button" class="login-secundario" id="btnEsqueciSenha">📧 Esqueci minha senha</button>
    <p class="login-info">Cada conta possui seus próprios dados. O acesso é protegido pelo Firebase Authentication.</p>
  </div>
</div>

<div id="barraUsuario">
  <small id="usuarioLogado"></small>
  <span id="usuarioPerfil" class="perfil-badge usuario">USUÁRIO</span>
  <button type="button" class="btn-logout" id="btnSair">Sair</button>
</div>


<header>
<h1>🍽️ GastroFlow</h1>
<p>Gestão completa para bar, restaurante, mesas e delivery</p>
</header>

<nav class="menu">
<button type="button" class="menu-btn" data-modulo="painel">🏠 Painel</button>
<button type="button" class="menu-btn" data-modulo="produtos">📦 Produtos</button>
<button type="button" class="menu-btn" data-modulo="estoque">🏪 Estoque</button>
<button type="button" class="menu-btn" data-modulo="mesas">🪑 Mesa/Comanda</button>
<button type="button" class="menu-btn" data-modulo="pedidos">🧾 Pedidos</button>
<button type="button" class="menu-btn" data-modulo="preparo">🔥 Em preparo</button>
<button type="button" class="menu-btn" data-modulo="pronto">✅ Pronto</button>
<button type="button" class="menu-btn" data-modulo="entregue">📦 Entregue</button>
<button type="button" class="menu-btn" data-modulo="delivery">🛵 Delivery</button>
<button type="button" class="menu-btn" data-modulo="caixa">💰 Caixa</button>
<button type="button" class="menu-btn" data-modulo="relatorios">📊 Relatórios</button>
<button type="button" class="menu-btn" data-modulo="suporte">📞 Contato e Suporte</button>
<button type="button" class="menu-btn" data-modulo="backup">💾 Backup</button>
<button type="button" id="btnMenuAdmin" class="menu-btn admin-only" data-modulo="admin">👑 Administrador</button>
<button type="button" class="menu-btn" data-modulo="cardapio">🍔 Cardápio Digital</button>
<button type="button" class="menu-btn" data-modulo="financeiro">💰 Financeiro/DRE</button>
<button type="button" class="menu-btn" data-modulo="fiscal">🧾 Fiscal</button>
<button type="button" class="menu-btn" data-modulo="garcom">📱 Garçom/QR Code</button>
</nav>

<main>

<section id="modulo-painel" class="modulo ativo">
<h2 class="titulo-modulo">🏠 Painel Inicial</h2>

<div class="painel-boas-vindas">
<h3>Bem-vindo ao GastroFlow 👋</h3>
<p>Acompanhe rapidamente o movimento do seu estabelecimento.</p>
</div>

<div class="painel-grid">
<div class="painel-card azul">
💰 Vendas do dia
<strong id="painelVendasDia">R$ 0,00</strong>
<small>Faturamento recebido hoje</small>
</div>

<div class="painel-card verde">
🧾 Vendas
<strong id="painelQuantidadeVendas">0</strong>
<small>Vendas recebidas hoje</small>
</div>

<div class="painel-card laranja">
🪑 Mesas abertas
<strong id="painelMesasAbertas">0</strong>
<small>Mesas em atendimento</small>
</div>

<div class="painel-card roxo">
🛵 Delivery
<strong id="painelPedidosDelivery">0</strong>
<small>Pedidos em andamento</small>
</div>

<div class="painel-card vermelho">
📦 Estoque baixo
<strong id="painelEstoqueBaixo">0</strong>
<small>Produtos precisam de atenção</small>
</div>

<div class="painel-card teal">
📈 Lucro estimado
<strong id="painelLucroDia">R$ 0,00</strong>
<small>Lucro estimado das vendas de hoje</small>
</div>
</div>

<div class="card">
<h3>⚡ Acesso rápido</h3>

<div class="painel-acoes">
<button type="button" class="btn btn-primary" data-painel-modulo="mesas">🪑 Abrir mesas</button>
<button type="button" class="btn btn-success" data-painel-modulo="delivery">🛵 Delivery</button>
<button type="button" class="btn btn-warning" data-painel-modulo="estoque">📦 Ver estoque</button>
<button type="button" class="btn btn-relatorio" data-painel-modulo="relatorios">📊 Relatórios</button>

</div>

<div class="card recursos-comerciais">
<h3>✨ Recursos do GastroFlow</h3>
<p class="recursos-intro">
Tudo o que seu estabelecimento precisa para organizar a operação em uma experiência simples.
</p>

<div class="recursos-grid">

<button type="button" class="recurso-comercial recurso-clicavel" data-recurso-modulo="cardapio" aria-label="Abrir Cardápio Digital">
<div class="recurso-icone">🍔</div>
<div>
<span class="recurso-categoria">CARDÁPIO DIGITAL</span>
<strong>Apresente produtos, adicionais e disponibilidade em uma jornada simples.</strong>
<span class="recurso-status">ATIVO</span>
</div>
</button>

<button type="button" class="recurso-comercial recurso-clicavel" data-recurso-modulo="estoque" aria-label="Abrir Estoque">
<div class="recurso-icone">📦</div>
<div>
<span class="recurso-categoria">CONTROLE</span>
<strong>Estoque</strong>
<p>Controle entradas, saídas e itens críticos com visão integrada.</p>
</div>
</button>

<button type="button" class="recurso-comercial recurso-clicavel" data-recurso-modulo="relatorios" aria-label="Abrir Financeiro e DRE">
<div class="recurso-icone">💰</div>
<div>
<span class="recurso-categoria">GESTÃO</span>
<strong>Financeiro e DRE</strong>
<p>Enxergue receitas, despesas e resultado com mais clareza.</p>
</div>
</button>

<button type="button" class="recurso-comercial recurso-clicavel" data-recurso-modulo="fiscal" aria-label="Abrir Emissão Fiscal">
<div class="recurso-icone">🧾</div>
<div>
<span class="recurso-categoria">FISCAL</span>
<strong>Emissão fiscal</strong>
<p>Prepare a operação para emitir documentos fiscais no fluxo de venda.</p>
<span class="recurso-status amarelo">INTEGRAÇÃO NECESSÁRIA</span>
</div>
</button>

<button type="button" class="recurso-comercial recurso-clicavel" data-recurso-modulo="garcom" aria-label="Abrir Garçom Digital e QR Code">
<div class="recurso-icone">📱</div>
<div>
<span class="recurso-categoria">MOBILIDADE</span>
<strong>Garçom digital e QR Code</strong>
<p>Dê mobilidade ao atendimento e autonomia ao cliente.</p>
<span class="recurso-status azul">ATIVO NO DISPOSITIVO</span>
</div>
</button>

</div>
</div>
</section>

<section id="modulo-produtos" class="modulo">
<h2 class="titulo-modulo">📦 Produtos</h2>

<div class="card">
<form id="formProduto">

<div class="form-grid">

<div>
<label>Nome do produto</label>
<input id="produtoNome" required>
</div>

<div>
<label>Categoria</label>
<input id="produtoCategoria">
</div>

<div>
<label>Preço de venda</label>
<input id="produtoPreco" type="number" step="0.01" min="0" required>
</div>

<div>
<label>Custo</label>
<input id="produtoCusto" type="number" step="0.01" min="0">
</div>

<div>
<label>Estoque inicial</label>
<input id="produtoEstoque" type="number" step="0.01" min="0">
</div>

<div>
<label>Estoque mínimo</label>
<input id="produtoEstoqueMinimo" type="number" step="0.01" min="0">
</div>

<div class="foto-produto-area">

<div class="preview-foto" id="previewFoto">
<div class="preview-foto-vazia">📷<br>Sem foto</div>
</div>

<div class="foto-produto-acoes">
<label>📸 Foto do produto</label>
<input id="produtoFoto" type="file" accept="image/*">

<p style="color:#64748b;margin-bottom:0">
Escolha uma foto da galeria ou tire uma foto pelo celular.
</p>

<div class="acoes">
<button type="button" class="btn btn-danger" id="btnRemoverFoto">
🗑️ Remover foto
</button>
</div>

</div>
</div>

</div>

<div class="acoes">
<button class="btn btn-primary" id="btnSalvar" type="submit">
💾 Salvar Produto
</button>

<button class="btn btn-secondary" id="btnCancelar" type="button">
Cancelar
</button>
</div>

</form>
</div>

<div class="resumo">
<div class="resumo-card">
Produtos cadastrados
<strong id="totalProdutos">0</strong>
</div>

<div class="resumo-card">
Produtos ativos
<strong id="produtosAtivos">0</strong>
</div>

<div class="resumo-card">
Produtos estoque baixo
<strong id="produtosEstoqueBaixo">0</strong>
</div>

<div class="resumo-card">
Total de unidades
<strong id="totalUnidades">0</strong>
</div>
</div>

<div class="card">
<input id="buscaProduto" placeholder="🔎 Buscar produto...">
</div>

<div id="listaProdutos" class="lista"></div>
</section>

<section id="modulo-estoque" class="modulo">

<h2 class="titulo-modulo">🏪 Estoque</h2>

<div class="card">

<form id="formMovimentacao">

<div class="form-grid">

<div>
<label>Produto</label>
<select id="estoqueProduto" required></select>
</div>

<div>
<label>Tipo</label>
<select id="tipoMovimentacao">
<option value="entrada">Entrada</option>
<option value="saida">Saída</option>
<option value="ajuste">Ajuste</option>
</select>
</div>

<div>
<label>Quantidade</label>
<input id="quantidadeMovimentacao" type="number" min="0" step="0.01" required>
</div>

<div>
<label>Motivo</label>
<input id="motivoMovimentacao">
</div>

</div>

<div class="acoes">
<button class="btn btn-primary" type="submit">
💾 Registrar movimentação
</button>
</div>

</form>

<div style="margin-top:20px">

<h3>Produto selecionado</h3>

<div class="resumo">

<div class="resumo-card">
Estoque atual
<strong id="estoqueAtualSelecionado">0</strong>
</div>

<div class="resumo-card">
Quantidade
<strong id="quantidadeEstoqueSelecionado">0</strong>
</div>

</div>

<div id="alertaEstoqueSelecionado"></div>

</div>
</div>

<div class="card">
<input id="buscaEstoque" placeholder="🔎 Buscar no estoque...">
</div>

<div id="listaEstoque" class="lista"></div>

<div class="card">
<h3>📋 Histórico de estoque</h3>
<div id="historicoEstoque"></div>
</div>

</section>

<section id="modulo-mesas" class="modulo">

<h2 class="titulo-modulo">🪑 Mesa / Comanda</h2>

<div class="card">
<p>
O GastroFlow possui <strong>500 mesas/comandas</strong>.
Abra uma mesa, registre os produtos e acompanhe todo o pedido.
</p>
</div>

<div id="listaMesas" class="mesas-grid"></div>

</section>

<section id="modulo-pedidos" class="modulo">

<h2 class="titulo-modulo">🧾 Pedidos</h2>

<div class="pedidos-fluxo">

<div class="pedido-etapa">
<span>🟡</span>
<strong id="fluxoPendentes">0</strong>
<small>Pendentes</small>
</div>

<div class="pedido-etapa">
<span>🔥</span>
<strong id="fluxoPreparo">0</strong>
<small>Em preparo</small>
</div>

<div class="pedido-etapa">
<span>✅</span>
<strong id="fluxoProntos">0</strong>
<small>Prontos</small>
</div>

<div class="pedido-etapa">
<span>📦</span>
<strong id="fluxoEntregues">0</strong>
<small>Entregues</small>
</div>

</div>

<div class="resumo">

<div class="resumo-card">
Pendentes
<strong id="pedidosPendentes">0</strong>
</div>

<div class="resumo-card">
Em preparo
<strong id="pedidosEmPreparo">0</strong>
</div>

<div class="resumo-card">
Total de itens
<strong id="pedidosTotalItens">0</strong>
</div>

</div>

<div id="listaPedidos" class="lista"></div>

</section>

<section id="modulo-preparo" class="modulo">

<h2 class="titulo-modulo">🔥 Em preparo</h2>

<div class="resumo">

<div class="resumo-card">
Mesas
<strong id="mesasEmPreparo">0</strong>
</div>

<div class="resumo-card">
Itens
<strong id="itensEmPreparo">0</strong>
</div>

