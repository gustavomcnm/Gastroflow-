function instalarListenersRecursosNovos(){
 document.getElementById("btnSalvarCardapio")?.addEventListener("click",salvarCardapioConfig);
 document.getElementById("btnAtualizarCardapio")?.addEventListener("click",renderizarCardapio);
 document.getElementById("buscaCardapio")?.addEventListener("input",renderizarCardapio);
 document.getElementById("formDespesa")?.addEventListener("submit",registrarDespesa);
 document.getElementById("btnSalvarFiscal")?.addEventListener("click",salvarFiscalConfig);
 document.getElementById("btnPrepararFiscal")?.addEventListener("click",prepararDocumentoFiscal);
 document.getElementById("btnExportarFiscal")?.addEventListener("click",()=>{const d=documentosFiscais[documentosFiscais.length-1];if(d)exportarObjetoFiscal(d);else mostrarMensagem("Nenhum documento preparado.","erro")});
 document.getElementById("btnGerarQR")?.addEventListener("click",gerarQR);
 document.getElementById("btnCopiarQR")?.addEventListener("click",copiarQR);
 document.addEventListener("click",e=>{const b=e.target.closest("[data-fiscal-export]");if(b){const d=documentosFiscais.find(x=>String(x.id)===String(b.dataset.fiscalExport));if(d)exportarObjetoFiscal(d)}});
}

document.addEventListener(
"DOMContentLoaded",
function(){

prepararManifesto();

instalarListenersRecursosNovos();

inicializarRecursosNovos();

atualizarPreviewFoto();

iniciarAutenticacao();

setTimeout(
mostrarBotaoInstalar,
1200
)

});
</script>

